{
  "name": "mian-foods-pos",
  "version": "1.4.1",
  "description": "Mian Foods POS system - Desi Swad, Fast Food",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir"
  },
  "build": {
    "appId": "com.mianfoods.pos.v2",
    "productName": "Mian Foods POS",
    "copyright": "Copyright © 2026 Muhammad Awais",
    "icon": "build/icon.ico",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "app.js",
      "style.css",
      "main.js",
      "logo.png",
      "logo.ico",
      "local-server.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Mian Foods POS",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  },
  "keywords": [
    "pos",
    "restaurant",
    "billing"
  ],
  "author": "Muhammad Awais",
  "license": "ISC",
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^3.0.1"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1"
  }
}
